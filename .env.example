# Development server defaults for BIFROST.
#
# Copy this file to assets/env/.env (git-ignored) and fill in API_KEY.
# Any value set here overrides the app's Settings, and the field is shown
# locked there. Leave a value empty to manage it in Settings instead.
# Rebuild the app after editing (the file is bundled at build time).
#
# DEVELOPMENT ONLY. A hosted server receives the camera images, and the key is
# bundled into the app build. Never use this for participant sessions; those
# must use the self-hosted vLLM server at McGill (Section 4).

MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=qwen/qwen3.8-27b:free
API_KEY=
REASONING_EFFORT=off
# The free tier can be slow; raise the timeout while testing.
TIMEOUT_S=30

# Turn logs (bifrost_logs server). The iOS simulator can use localhost;
# a real phone needs the computer's Wi-Fi address, e.g. http://192.168.1.20:8787
LOG_SERVER_URL=http://localhost:8787
LOG_TOKEN=
PARTICIPANT=dev
